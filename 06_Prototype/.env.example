# ReviewSense AI — Environment Configuration
# Configure any OpenAI-compatible LLM endpoint (OpenAI, Groq, xAI, OpenRouter, Ollama, etc.)

# API Base URL (defaults to OpenAI or compatible endpoint)
LLM_BASE_URL=https://api.openai.com/v1

# Model identifier (e.g., gpt-4o-mini, groq/llama-3.3-70b-versatile, grok-3-mini, etc.)
LLM_MODEL=gpt-4o-mini

# API Key (replace with your actual API key)
LLM_API_KEY=your_api_key_here
